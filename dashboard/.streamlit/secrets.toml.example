# Copy this file to .streamlit/secrets.toml and replace the example values with your real database credentials.
# The dashboard reads these values with st.secrets[...] in dashboard/db_connection.py.
DB_HOST = "your-db-host.supabase.co"
DB_PORT = "5432"
DB_NAME = "postgres"
DB_USER = "postgres"
DB_PASSWORD = "your_secure_password"

# Optional: keep this if your provider requires it.
DB_SSLMODE = "require"
